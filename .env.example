# ===== Scraper Ayarları =====
SCRAPE_INTERVAL_HOURS=6
HEADLESS_BROWSER=true

# ===== Flask =====
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
FLASK_PORT=5000
FLASK_DEBUG=false
