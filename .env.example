# Gmail SMTP Ayarları
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# E-posta gönderecek Gmail adresiniz
SENDER_EMAIL=your_email@gmail.com

# Gmail Uygulama Şifreniz (App Password)
# Not: Normal şifreniz değil, Google Hesabınızdan "Uygulama Şifreleri" kısmından aldığınız 16 haneli şifredir.
SENDER_PASSWORD=your_16_char_app_password

# Telegram Bot Ayarları
# Telegram'da @BotFather üzerinden oluşturduğunuz botun API Token'ı
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
